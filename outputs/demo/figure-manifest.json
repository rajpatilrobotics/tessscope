  "figures": {
    "causal-comparison": {
      "after_pq": 0.552294837627718,
      "alt": "A paired chart shows exact-design PQ rising from 0.4922 before correction to 0.5523 after correction. A forest plot shows a positive confidence interval for exact versus stopped gradients and a confidence interval crossing zero for exact versus piecewise.",
      "before_pq": 0.4921920085941332,
      "caption": "The exact design increases its own hard off-focus PQ from 0.4922 to 0.5523 after one predicted stage action. The causal comparison against its forward-identical stopped-gradient control is +0.0063 PQ with a 95% well-bootstrap interval of +0.0007 to +0.0115. The comparison against piecewise-028 is only +0.0013 with an interval from \u22120.0017 to +0.0048, so superiority over piecewise is not supported.",
      "comparisons": [
        {
          "candidate": "v2_3-exact-balanced-segmentation_only-step-14",
          "ci_lower_95": 0.0006703181908061804,
          "ci_upper_95": 0.011547458540670894,
